# authService environment (copy this file to `.env` and fill in the values).
# `.env` is git-ignored and must never be committed.

# --- Keycloak PostgreSQL database (internal network only) ---
KC_DB_NAME=keycloakdb
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=

# --- Keycloak bootstrap admin (master realm, admin console) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Secret of the confidential jacapp-backend client (service account) ---
# Used by the realm import through the ${JC_CLIENT_SECRET} placeholder.
# Must match KEYCLOAK_CLIENT_SECRET in the userService `.env` file.
JC_CLIENT_SECRET=
